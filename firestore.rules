rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita para coleções do sistema de rede FTTH
    match /projects/{projectId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /snapshots/{snapshotId} {
      allow read, write: if true;
    }
  }
}
